# --- App ---
PORT=3000
NODE_ENV=development

# --- Database ---
# SQLite (default, recommended for local setup)
DATABASE_URL="file:./dev.db"
# PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/internship_db?schema=public"
# MySQL example:
# DATABASE_URL="mysql://user:password@localhost:3306/internship_db"

# --- Auth ---
# Use a long, random string in real environments. Never commit real secrets.
JWT_SECRET="replace-with-a-long-random-secret-string"
JWT_EXPIRES_IN="1d"

# --- Seed admin account (used by prisma/seed.ts) ---
SEED_ADMIN_EMAIL="[email protected]"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="System Administrator"
